# OTW read-only MCP transport used by the current server deployment.
OTW_BASE_URL=https://your-otw-host.example
OTW_API_TOKEN=
OTW_TRANSPORT=mcp
ENGINE_MODE=preview
ENGINE_API_TOKEN=

# Market data and persistent local cache (no API key required for the initial AKShare adapter).
MARKET_DATA_PROVIDER=akshare
ENGINE_DATA_DIR=/data
MARKET_DATA_DEFAULT_START_DATE=20180101
MARKET_DATA_DEFAULT_ADJUSTMENT=qfq

# Docker build-time package mirror; defaults to official PyPI.
PIP_INDEX_URL=https://pypi.org/simple

# Optional manually reviewed evidence file. Never treat it as independently verified.
ENGINE_EVIDENCE_PATH=
