# OTW API: hostname of YOUR server; the authentication token is not included in this repository.
OTW_BASE_URL=https://your-otw-host.example
OTW_API_TOKEN=
# Strategy IDs are discovered from GET /api/paper-trading/strategies.
# Supply strategy_id per preview request, or --all-active for read-only batch preview.
# Reads only. No POST /orders implementation in v0.1.
ENGINE_MODE=preview
# Required before enabling HTTP OTW preview. Use a separate random secret, not your OTW token.
ENGINE_API_TOKEN=
# Optional local evidence / bars paths. Evidence is user-provided, NOT independently verified by the engine.
ENGINE_EVIDENCE_PATH=
ENGINE_BARS_PATH=
# CORS/public exposure are intentionally not configured. Bind service to 127.0.0.1 only.
