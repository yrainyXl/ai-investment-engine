# OTW read-only MCP transport used by the current server deployment.
OTW_BASE_URL=https://your-otw-host.example
OTW_API_TOKEN=
OTW_TRANSPORT=mcp
ENGINE_MODE=preview
ENGINE_API_TOKEN=

# Optional: independent manual review credential. Empty/absent disables approvals.
# Must be different from ENGINE_API_TOKEN; do not give this to automated agents.
ENGINE_FACT_REVIEW_TOKEN=

# Market data and persistent local cache (no API key required for the initial AKShare adapter).
MARKET_DATA_PROVIDER=akshare
ENGINE_DATA_DIR=/data
MARKET_DATA_DEFAULT_START_DATE=20180101
MARKET_DATA_DEFAULT_ADJUSTMENT=qfq

# Docker build-time package mirror; defaults to official PyPI.
PIP_INDEX_URL=https://pypi.org/simple

# Optional manually reviewed evidence file. Never treat it as independently verified.
ENGINE_EVIDENCE_PATH=

# Optional read-only account adapter for /v1/research/analyze. Use the
# documented REST API base and an explicit asset-to-strategy map.
ENGINE_OTW_RESEARCH_BASE_URL=
ENGINE_OTW_RESEARCH_TOKEN=
ENGINE_OTW_RESEARCH_STRATEGIES='{}'

# Billable model calls are off by default. Set authorization, credentials,
# configured provider pricing, and per-research-run budget together.
ENGINE_LLM_ENABLED=false
ENGINE_LLM_PROVIDER=
ENGINE_LLM_BASE_URL=
ENGINE_LLM_API_KEY=
ENGINE_LLM_MODEL=
ENGINE_LLM_MAX_COST_USD=
ENGINE_LLM_INPUT_COST_PER_MILLION=
ENGINE_LLM_OUTPUT_COST_PER_MILLION=
ENGINE_LLM_MAX_INPUT_TOKENS=24000
ENGINE_LLM_MAX_OUTPUT_TOKENS=1200
ENGINE_LLM_TIMEOUT_SECONDS=20
